  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "lefthook": "1.13.6",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "packageManager": "bun@1.3.5"
}
